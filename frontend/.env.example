# Copy to .env.local and fill in. A provider shows up in the switcher once its vars are set.
VITE_API_URL=http://localhost:8000
# Shown in the header; handy when running a second app for the SSO demo
VITE_APP_NAME=Auth Providers
# Provider used on first visit: auth0 | supabase | keycloak
VITE_DEFAULT_PROVIDER=supabase

# Auth0
VITE_AUTH0_DOMAIN=dev-xxxx.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://auth-providers-api

# Supabase: Project URL and the publishable key (sb_publishable_...) or legacy anon key
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=

# Keycloak (public client, no secret)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=auth-providers
VITE_KEYCLOAK_CLIENT_ID=auth-providers-spa
# "Sign in with SSO": email domain → identity provider alias in Keycloak
VITE_KEYCLOAK_SSO_DOMAINS=acme.com:acme
# Optional fallback IdP for domains not listed above (empty = regular Keycloak login form)
VITE_KEYCLOAK_SSO_IDP=
